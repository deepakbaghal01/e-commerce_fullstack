# Copy to .env and replace all placeholders with your own credentials.
MONGODB_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
OTP_SECRET=replace_with_a_random_secret_at_least_32_characters
# Set to false to temporarily allow registration and login without phone OTP verification.
OTP_VERIFICATION_ENABLED=true
PORT=5000

# Comma-separated frontend origins allowed by CORS; set the deployed Vercel origin in production.
CLIENT_ORIGINS=https://client-iota-snowy.vercel.app

# Phone verification (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000

# Local development only: codes appear in the server terminal.
# Configure Twilio SMS delivery in production.

VERIFICATION_DELIVERY_MODE=console
