# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ecommerce

# Generate separate random secrets for JWT and OTP hashing
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
OTP_SECRET=replace_with_a_random_secret_at_least_32_characters

# Twilio SMS delivery (use an E.164-enabled sender number)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000

# Local development only. Do not use console delivery in production.
VERIFICATION_DELIVERY_MODE=console

# Server port
PORT=5000
